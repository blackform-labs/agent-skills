{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "herd-orchestrator review verdict",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict",
    "criteria",
    "out_of_scope_edits",
    "summary"
  ],
  "properties": {
    "verdict": {
      "enum": [
        "PASS",
        "NEEDS_IMPROVEMENT",
        "FAIL"
      ]
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "evidence",
          "fix"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "pass",
              "fail"
            ]
          },
          "evidence": {
            "type": "string"
          },
          "fix": {
            "type": "string"
          }
        }
      }
    },
    "out_of_scope_edits": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "string"
    }
  }
}