{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "herd-orchestrator development plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign",
    "defaults",
    "steps"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "campaign": {
      "$ref": "#/$defs/text"
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "worker",
        "reviewer",
        "max_retries"
      ],
      "properties": {
        "worker": {
          "enum": [
            "codex",
            "claude"
          ]
        },
        "reviewer": {
          "enum": [
            "codex",
            "claude"
          ]
        },
        "max_retries": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "prerequisites": {
      "description": "Optional check commands run on the user's machine before Run; each must exit 0 (for example pg_isready).",
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "maxLength": 500,
        "pattern": "^[^\\n\\r]*\\S[^\\n\\r]*$"
      }
    },
    "setup": {
      "description": "Optional install commands (for example npm ci) that Shogun runs itself, with network, in the campaign worktree before the first battle (or after setup_after). Approving the plan approves these exact commands.",
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "string",
        "maxLength": 500,
        "pattern": "^[^\\n\\r]*\\S[^\\n\\r]*$"
      }
    },
    "setup_after": {
      "description": "Optional step ID whose commit creates what setup needs (for example package.json); setup then runs after that step instead of before the first battle.",
      "$ref": "#/$defs/text"
    }
  },
  "dependentRequired": {
    "setup_after": [
      "setup"
    ]
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "texts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "line": {
      "type": "string",
      "maxLength": 300,
      "pattern": "^[^\\n\\r]*\\S[^\\n\\r]*$"
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "goal",
        "acceptance",
        "verify",
        "depends_on",
        "touches",
        "needs_approval",
        "status"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/text"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "goal": {
          "$ref": "#/$defs/text"
        },
        "acceptance": {
          "$ref": "#/$defs/texts",
          "minItems": 1
        },
        "verify": {
          "$ref": "#/$defs/texts",
          "minItems": 1
        },
        "depends_on": {
          "$ref": "#/$defs/texts"
        },
        "touches": {
          "$ref": "#/$defs/texts"
        },
        "needs_approval": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "pending",
            "running",
            "verifying",
            "reviewing",
            "awaiting_approval",
            "done",
            "blocked",
            "skipped",
            "cancelled",
            "interrupted"
          ]
        },
        "hard_gate": {
          "description": "Optional. Recorded human acceptance or a new authorization: the step always pauses for approval and no mode waives it, --unattended included.",
          "type": "boolean"
        },
        "human_tasks": {
          "description": "Optional work only a person can do, kept out of the worker prompt. After the step's commit Shogun stops and records the answer as evidence.",
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "do",
              "evidence"
            ],
            "properties": {
              "do": {
                "$ref": "#/$defs/line"
              },
              "evidence": {
                "$ref": "#/$defs/line"
              }
            }
          }
        }
      }
    }
  }
}